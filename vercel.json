{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "functions": {
        "server.js": {
          "maxDuration": 300,
          "includeFiles": [
            "node_modules/@sparticuz/chromium/bin/**"
          ]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
